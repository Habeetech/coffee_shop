      "options": {}
    }
  ],
  "total": 5.50,
  "customer": {
    "firstName": "Habeeb",
    "lastName": "Ola",
    "email": "example@email.com",
    "deliveryOption": "collection",
    "address": {}
  },
  "status": "pending",
  "paymentMethod": "stripe",
  "stripeId": "pi_3TJdIqIzM8ZcbdVL12r6OrDm"
}
### Patch: Link Order ID to Stripe Payment Intent
PATCH http://localhost:3000/api/payment-intent/update
Content-Type: application/json

{
    "orderId": "69aec52dc964f514c51ebd99",
    "paymentId": "pi_3TJdIqIzM8ZcbdVL12r6OrDm"
}